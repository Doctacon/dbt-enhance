Screen {
    background: $background;
    color: $foreground;
}

#shell {
    height: 100%;
    padding: 0 1;
    background: $background;
}

#header { height: 1; }
#brand { color: $primary; text-style: bold; width: auto; }
#subtitle { color: $secondary; width: auto; margin-left: 1; }
#context { color: $secondary; height: 1; overflow: hidden; }
#run-context { color: $quiet; height: 1; overflow: hidden; }
#execution { height: 1; }
#spinner { width: 3; color: $warning; }
#status { color: $warning; width: 1fr; }
#result-meta { color: $primary; width: auto; height: 1; }

#warnings-panel, #message-panel {
    height: auto;
    max-height: 3;
    overflow-y: auto;
    color: $warning;
    border-left: thick $warning;
    padding-left: 1;
}

#sql-panel {
    height: auto;
    max-height: 6;
    overflow-y: auto;
    overflow-x: auto;
    border: round $secondary;
    padding: 0 1;
}

#sql-panel:focus, #warnings-panel:focus, #message-panel:focus, #detail-panel:focus {
    border: round $primary;
}

#results {
    height: 1fr;
    min-height: 6;
    margin-top: 0;
    background: $surface;
    color: $foreground;
    border: round $secondary;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor { background: $panel; color: $foreground; }
DataTable > .datatable--fixed { background: $panel; color: $foreground; }

#detail-panel {
    height: auto;
    max-height: 3;
    overflow-y: auto;
    border: round $secondary;
    padding: 0 1;
}

#detail { color: $foreground; }
#help { height: 1; color: $quiet; overflow: hidden; }

/* Scrollable, focusable dialogs retain their controls on narrow terminals. */
#backend-choice-dialog {
    width: 60;
    max-width: 94%;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

ActionDialog #backend-choice-dialog { height: 85%; }
#action-results { height: 1fr; min-height: 3; border: none; background: $surface; }
#action-results > .option-list--option-highlighted { background: $panel; color: $foreground; }

#choice-title { text-style: bold; color: $foreground; }
#choice-copy { color: $secondary; margin: 1 0; }
#backend-choice-dialog Horizontal { height: auto; }
#backend-choice-dialog Button { margin-right: 1; width: 1fr; min-width: 0; }

#review-dialog {
    width: 90;
    max-width: 94%;
    height: 85%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}
#review-title { height: auto; text-style: bold; color: $primary; }
#review-help { height: auto; color: $secondary; }
#review-scroll { height: 1fr; overflow-y: auto; margin: 1 0; }
#review-scroll:focus { border-left: thick $primary; }
#review-controls { height: 3; }
#review-controls Button { width: 1fr; min-width: 0; margin-right: 1; }
